{
  "name": "audio-assistant",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "node --experimental-strip-types agent/lib/host.ts",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@vercel/connect": "2.5.2",
    "ai": "7.0.143",
    "eve": "0.80.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
